#!/usr/bin/env bash
# Resolve and ensure the workspace-local directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.tmp/subagent-driven-development/<plan-basename>/)
# so a follow-up plan in the same workspace can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# The workspace lives under the Jujutsu workspace root's .tmp directory. If
# the command runs outside a Jujutsu workspace, it falls back to .tmp under
# the current directory. Jujutsu currently uses .gitignore files for ignore
# rules, so the owned artifact namespace ignores itself before artifacts are
# written and cannot be auto-tracked into the working-copy revision.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

if root=$(jj --ignore-working-copy workspace root 2>/dev/null); then
  :
else
  root=$PWD
fi
base="$root/.tmp/subagent-driven-development"
dir="$base/$slug"
mkdir -p "$base"
printf '*\n' > "$base/.gitignore"
mkdir -p "$dir"
cd "$dir" && pwd
