#!/usr/bin/env bash
# Resolve and ensure the RocketClaw directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the artifact directory's absolute path.
#
# One directory per plan (.rocketclaw/sdd/<plan-basename>/) so a follow-up
# plan in the same Jujutsu workspace can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# The artifact directory lives in the working copy rather than repository internals so
# implementer subagents can write report files. A self-ignoring .gitignore at
# .rocketclaw/sdd/ keeps every plan's workspace out of `jj status` and out of
# accidental commits without modifying any tracked file.
#
# Single source of truth for the artifact location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: sdd-workspace PLAN_FILE
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: sdd-workspace PLAN_FILE" >&2
  exit 2
fi

plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

root=$(jj workspace root)
base="$root/.rocketclaw/sdd"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
