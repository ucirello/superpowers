#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not @~ or a single-parent walk)
# keeps multi-change tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.rocketclaw/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
# BASE and HEAD are jj revisions (bookmarks, change/commit ids, or @).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj log -r "$base" --no-graph >/dev/null 2>&1 || { echo "bad BASE: $base" >&2; exit 2; }
jj log -r "$head" --no-graph >/dev/null 2>&1 || { echo "bad HEAD: $head" >&2; exit 2; }

short_id() {
  jj log -r "$1" -T 'commit_id.short(7)' --no-graph
}

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-$(short_id "$base")..$(short_id "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  jj log -r "${base}..${head}" --no-graph -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --from "$base" --to "$head" --stat
  echo
  echo "## Diff"
  jj diff --from "$base" --to "$head" -U10
} > "$out"

commits=$(jj log -r "${base}..${head}" --no-graph -T 'commit_id ++ "\n"' | grep -c . || true)
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
