#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using recorded boundary revisions keeps multi-revision tasks intact.
#
# Usage: review-package PLAN_FILE BASE END [OUTFILE]
# Default OUTFILE: <workspace-root>/.rocketclaw/sdd/<plan-basename>/review-<base12>..<end12>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE END [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
end=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

resolve_one() {
  label=$1
  revset=$2
  resolved=$(jj log --no-graph -r "$revset" -T 'commit_id ++ "\n"' 2>/dev/null) \
    || { echo "bad $label: $revset" >&2; exit 2; }
  lines=$(printf '%s\n' "$resolved" | wc -l | tr -d ' ')
  [ -n "$resolved" ] && [ "$lines" -eq 1 ] \
    || { echo "$label must resolve to exactly one revision: $revset" >&2; exit 2; }
  printf '%s\n' "$resolved"
}

base_id=$(resolve_one BASE "$base")
end_id=$(resolve_one END "$end")
base_rev="commit_id(\"$base_id\")"
end_rev="commit_id(\"$end_id\")"
range="$base_rev..$end_rev"
is_descendant=$(jj log --count -r "$base_rev::$end_rev & $end_rev")
[ "$is_descendant" -eq 1 ] \
  || { echo "END is not a descendant of BASE: $base..$end" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base_id:0:12}..${end_id:0:12}.diff"
fi

{
  echo "# Review package: ${base_id}..${end_id}"
  echo
  echo "## Revisions"
  jj log --no-graph -r "$range" \
    -T 'commit_id.short(12) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --from "$base_rev" --to "$end_rev" --stat
  echo
  echo "## Diff"
  jj diff --from "$base_rev" --to "$end_rev" --context 10
} > "$out"

revisions=$(jj log --count -r "$range")
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
