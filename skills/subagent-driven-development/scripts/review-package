#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE and HEAD changes keeps multi-change
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <workspace-root>/.rocketclaw/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj log -r "$base" --no-graph -T 'change_id ++ "\n"' >/dev/null \
  || { echo "bad BASE revset: $base" >&2; exit 2; }
jj log -r "$head" --no-graph -T 'change_id ++ "\n"' >/dev/null \
  || { echo "bad HEAD revset: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  base_short=$(jj log -r "$base" --no-graph -T 'change_id.short(7)')
  head_short=$(jj log -r "$head" --no-graph -T 'change_id.short(7)')
  out="$dir/review-${base_short}..${head_short}.diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Changes"
  jj log -r "${base}..${head}" --no-graph \
    -T 'change_id.short(7) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --from "$base" --to "$head" --stat
  echo
  echo "## Diff"
  jj diff --from "$base" --to "$head" --context 10
} > "$out"

changes=$(jj log -r "${base}..${head}" --no-graph -T 'change_id ++ "\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
