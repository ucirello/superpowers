#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not @--) keeps multi-revision
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# Default OUTFILE: <workspace-root>/.rocketclaw/sdd/<plan-basename>/review-<base>..<tip>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base_commit=$(jj --ignore-working-copy log --no-graph -r "exactly($base, 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "bad BASE revision: $base" >&2; exit 2; }
tip_commit=$(jj --ignore-working-copy log --no-graph -r "exactly($tip, 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "bad TIP revision: $tip" >&2; exit 2; }
base_id=${base_commit:0:12}
tip_id=${tip_commit:0:12}

[ "$(jj --ignore-working-copy log --count -r "$base_commit & ::$tip_commit")" -eq 1 ] \
  || { echo "TIP is not a descendant of BASE" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base_id}..${tip_id}.diff"
fi

{
  echo "# Review package: ${base}..${tip}"
  echo
  echo "## Revisions"
  jj --ignore-working-copy log --no-graph -r "${base_commit}..${tip_commit}" \
    -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --stat --from "$base_commit" --to "$tip_commit"
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --git --context 10 --from "$base_commit" --to "$tip_commit"
} > "$out"

revisions=$(jj --ignore-working-copy log --count -r "${base_commit}..${tip_commit}")
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
