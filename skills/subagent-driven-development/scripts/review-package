#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE keeps multi-change tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# BASE and TIP must each be a Jujutsu revset resolving to exactly one revision.
# Default OUTFILE: <workspace-root>/.tmp/rocketclaw/sdd/<plan-basename>/review-<base>..<tip>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

resolve_revision() {
  label=$1
  expression=$2
  jj --ignore-working-copy log --no-graph -r "exactly(($expression), 1)" -T 'commit_id ++ "\n"' 2>/dev/null \
    || { echo "$label must resolve to exactly one Jujutsu revision: $expression" >&2; exit 2; }
}

base_id=$(resolve_revision BASE "$base")
tip_id=$(resolve_revision TIP "$tip")
base_short=$(jj --ignore-working-copy log --no-graph -r "$base_id" -T 'commit_id.shortest(8) ++ "\n"')
tip_short=$(jj --ignore-working-copy log --no-graph -r "$tip_id" -T 'commit_id.shortest(8) ++ "\n"')

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base_short}..${tip_short}.diff"
fi

{
  echo "# Review package: ${base_id}..${tip_id}"
  echo
  echo "## Changes"
  jj --ignore-working-copy log --no-graph -r "${base_id}..${tip_id}" \
    -T 'change_id.shortest(8) ++ " " ++ commit_id.shortest(8) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --from "$base_id" --to "$tip_id" --stat
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --from "$base_id" --to "$tip_id" --context 10
} > "$out"

changes=$(jj --ignore-working-copy log --no-graph -r "${base_id}..${tip_id}" -T '"change\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
