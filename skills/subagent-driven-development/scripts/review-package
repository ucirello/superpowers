#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task base and current commit IDs keeps
# multi-change tasks intact.
#
# Usage: review-package PLAN_FILE BASE_REVISION CURRENT_REVISION [OUTFILE]
# Default OUTFILE: <workspace-root>/.tmp/sdd/<plan-basename>/review-<base7>..<current7>.diff
# (named per revset bounds, so a re-review after fixes gets a fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE_REVISION CURRENT_REVISION [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
current=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base_id=$(jj --ignore-working-copy log --no-graph -r "exactly(($base), 1)" -T 'commit_id ++ "\n"') \
  || { echo "bad BASE_REVISION: $base" >&2; exit 2; }
current_id=$(jj --ignore-working-copy log --no-graph -r "exactly(($current), 1)" -T 'commit_id ++ "\n"') \
  || { echo "bad CURRENT_REVISION: $current" >&2; exit 2; }
revset="${base_id}..${current_id}"

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  base_short=$(jj --ignore-working-copy log --no-graph -r "$base_id" -T 'commit_id.short(7) ++ "\n"')
  current_short=$(jj --ignore-working-copy log --no-graph -r "$current_id" -T 'commit_id.short(7) ++ "\n"')
  out="$dir/review-${base_short}..${current_short}.diff"
fi

{
  echo "# Review package: ${base_id}..${current_id}"
  echo
  echo "## Revisions (change ID, commit ID, description)"
  jj --ignore-working-copy log --no-graph -r "$revset" \
    -T 'change_id.shortest(8) ++ " " ++ commit_id.shortest(8) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --from "$base_id" --to "$current_id" --stat
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --from "$base_id" --to "$current_id" --git --context 10
} > "$out"

revisions=$(jj --ignore-working-copy log --no-graph -r "$revset" -T '"revision\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
