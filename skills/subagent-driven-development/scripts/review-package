#!/usr/bin/env bash
# Generate a review package: revision list, head summary, stat summary, and the
# net diff with extended context, written to a file the reviewer reads in one
# call. Resolve endpoints to commit IDs so the package stays pinned to the
# exact snapshots selected for review.
#
# Usage: review-package PLAN_FILE BASE_REVISION HEAD_REVISION [OUTFILE]
# Default OUTFILE: <workspace-root>/.rocketclaw/sdd/<plan-basename>/review-<base12>--<head12>.diff
# (named per endpoints, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE_REVISION HEAD_REVISION [OUTFILE]" >&2
  exit 2
fi

plan=$1
base_revision=$2
head_revision=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base=$(jj --color never --no-pager log --no-graph -r "exactly($base_revision, 1)" -T 'commit_id ++ "\n"') \
  || { echo "BASE_REVISION must resolve to exactly one revision: $base_revision" >&2; exit 2; }
head=$(jj --color never --no-pager log --no-graph -r "exactly($head_revision, 1)" -T 'commit_id ++ "\n"') \
  || { echo "HEAD_REVISION must resolve to exactly one revision: $head_revision" >&2; exit 2; }
base_rev="commit_id($base)"
head_rev="commit_id($head)"
revisions="$base_rev::$head_rev ~ $base_rev"

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base:0:12}--${head:0:12}.diff"
fi

{
  echo "# Review package: ${base}::${head}"
  echo
  echo "## Revisions"
  jj --color never --no-pager log --no-graph -r "$revisions" -T 'commit_id.shortest(12) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Head revision"
  jj --color never --no-pager show --stat "$head_rev"
  echo
  echo "## Files changed"
  jj --color never --no-pager diff --stat --from "$base_rev" --to "$head_rev"
  echo
  echo "## Diff"
  jj --color never --no-pager diff --git --context 10 --from "$base_rev" --to "$head_rev"
} > "$out"

revision_count=$(jj --color never --no-pager log --no-graph -r "$revisions" -T '"revision\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${revision_count} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
