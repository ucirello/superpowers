#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not TIP-) keeps multi-revision
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# Default OUTFILE: <repo-root>/.rocketclaw/sdd/<plan-basename>/review-<base-id>..<tip-id>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj --ignore-working-copy log -r "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
jj --ignore-working-copy log -r "$tip" >/dev/null || { echo "bad TIP: $tip" >&2; exit 2; }

base_id=$(jj --ignore-working-copy log --no-graph -r "$base" -T 'commit_id ++ "\n"')
tip_id=$(jj --ignore-working-copy log --no-graph -r "$tip" -T 'commit_id ++ "\n"')
range="${base_id}..${tip_id}"

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  base_short=$(jj --ignore-working-copy log --no-graph -r "$base_id" -T 'commit_id.shortest(8)')
  tip_short=$(jj --ignore-working-copy log --no-graph -r "$tip_id" -T 'commit_id.shortest(8)')
  out="$dir/review-${base_short}..${tip_short}.diff"
fi

{
  echo "# Review package: ${base_id}..${tip_id}"
  echo
  echo "## Revisions"
  jj --ignore-working-copy log --no-graph -r "$range" \
    -T 'commit_id.shortest(8) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --from "$base_id" --to "$tip_id" --stat
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --from "$base_id" --to "$tip_id" --git --context 10
} > "$out"

revisions=$(jj --ignore-working-copy log -r "$range" --count)
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
