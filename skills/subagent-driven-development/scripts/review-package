#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using recorded commit snapshots for BASE_COMMIT_ID and TIP_COMMIT_ID
# keeps multi-change tasks intact.
#
# Usage: review-package PLAN_FILE BASE_COMMIT_ID TIP_COMMIT_ID [OUTFILE]
# Default OUTFILE: <workspace-root>/.rocketclaw/sdd/<plan-basename>/review-<base7>..<tip7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE_COMMIT_ID TIP_COMMIT_ID [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj log -r "exactly(commit_id($base), 1)" --no-graph -T 'commit_id ++ "\n"' >/dev/null \
  || { echo "bad BASE commit ID: $base" >&2; exit 2; }
jj log -r "exactly(commit_id($tip), 1)" --no-graph -T 'commit_id ++ "\n"' >/dev/null \
  || { echo "bad TIP commit ID: $tip" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  base_short=$(jj log -r "commit_id($base)" --no-graph -T 'commit_id.shortest(7)')
  tip_short=$(jj log -r "commit_id($tip)" --no-graph -T 'commit_id.shortest(7)')
  out="$dir/review-${base_short}..${tip_short}.diff"
fi

{
  echo "# Review package: ${base}..${tip}"
  echo
  echo "## Changes"
  jj log --no-graph -r "commit_id($base)..commit_id($tip)" \
    -T 'change_id.shortest(7) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --stat --from "commit_id($base)" --to "commit_id($tip)"
  echo
  echo "## Diff"
  jj diff --context 10 --from "commit_id($base)" --to "commit_id($tip)"
} > "$out"

changes=$(jj log --count -r "commit_id($base)..commit_id($tip)")
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
