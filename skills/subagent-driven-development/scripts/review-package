#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. The endpoints are immutable commit IDs captured as revision snapshots;
# change IDs are stable across rewrites and therefore cannot delimit old state.
#
# Usage: review-package PLAN_FILE BASE_REV TARGET_REV [OUTFILE]
# Default OUTFILE: <workspace-root>/.tmp/rocketclaw/sdd/<plan-basename>/review-<base>..<target>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE_REV TARGET_REV [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
target=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj --ignore-working-copy log -r "exactly($base, 1)" --no-graph \
  -T 'commit_id' >/dev/null 2>&1 \
  || { echo "BASE_REV must resolve to exactly one revision: $base" >&2; exit 2; }
jj --ignore-working-copy log -r "exactly($target, 1)" --no-graph \
  -T 'commit_id' >/dev/null 2>&1 \
  || { echo "TARGET_REV must resolve to exactly one revision: $target" >&2; exit 2; }

dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
base_short=$(jj --ignore-working-copy log -r "$base" --no-graph -T 'commit_id.short(12)')
target_short=$(jj --ignore-working-copy log -r "$target" --no-graph -T 'commit_id.short(12)')

if [ $# -eq 4 ]; then
  out=$4
else
  out="$dir/review-${base_short}..${target_short}.diff"
fi

case "$out" in
  "$dir"/*)
    leaf=${out#"$dir"/}
    case "$leaf" in
      */*|.|..) echo "output must be a direct child of: $dir" >&2; exit 2 ;;
    esac
    ;;
  *) echo "output must be inside the plan's repository-local temporary directory: $dir" >&2; exit 2 ;;
esac
[ ! -L "$out" ] || { echo "refusing symlinked output file: $out" >&2; exit 2; }

tmp_out="$out.$$"
(set -C; : > "$tmp_out") 2>/dev/null \
  || { echo "could not safely create temporary output: $tmp_out" >&2; exit 2; }
trap 'rm -f "$tmp_out"' EXIT HUP INT TERM
{
  echo "# Review package: ${base}..${target}"
  echo
  echo "## Changes"
  jj --ignore-working-copy log -r "${base}..${target}" --no-graph \
    -T 'change_id.shortest() ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --from "$base" --to "$target" --stat
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --from "$base" --to "$target" --context 10
} > "$tmp_out"

mv -f "$tmp_out" "$out"
trap - EXIT HUP INT TERM

changes=$(jj --ignore-working-copy log -r "${base}..${target}" --no-graph \
  -T '"1\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
