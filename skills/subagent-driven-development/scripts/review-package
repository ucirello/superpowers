#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not @-) keeps multi-change
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.rocketclaw/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
#
# BASE and HEAD are jj revsets (commit ids, change ids, bookmarks, @, etc.).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj log -r "$base" -n 1 --no-graph -T 'commit_id' >/dev/null 2>&1 \
  || { echo "bad BASE: $base" >&2; exit 2; }
jj log -r "$head" -n 1 --no-graph -T 'commit_id' >/dev/null 2>&1 \
  || { echo "bad HEAD: $head" >&2; exit 2; }

base7=$(jj log -r "$base" -n 1 --no-graph -T 'commit_id.short(7)')
head7=$(jj log -r "$head" -n 1 --no-graph -T 'commit_id.short(7)')

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base7}..${head7}.diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Changes"
  jj log -r "${base}..${head}" --no-graph -T 'builtin_log_oneline'
  echo
  echo "## Files changed"
  jj diff --from "$base" --to "$head" --stat
  echo
  echo "## Diff"
  jj diff --from "$base" --to "$head" --context 10
} > "$out"

changes=$(jj log -r "${base}..${head}" --no-graph -T 'commit_id++"\n"' | grep -c . || true)
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
