#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not @-) keeps multi-commit
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE HEAD [OUTFILE]
# Default OUTFILE: <repo-root>/.rocketclaw/sdd/<plan-basename>/review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

jj log -r "$base" -T 'commit_id' --no-graph >/dev/null 2>&1 || { echo "bad BASE: $base" >&2; exit 2; }
jj log -r "$head" -T 'commit_id' --no-graph >/dev/null 2>&1 || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  base_short=$(jj log -r "$base" -T 'commit_id.short()' --no-graph)
  head_short=$(jj log -r "$head" -T 'commit_id.short()' --no-graph)
  out="$dir/review-${base_short}..${head_short}.diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  jj log -r "${base}..${head}" --no-graph -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --stat --from "$base" --to "$head"
  echo
  echo "## Diff"
  jj diff --from "$base" --to "$head" --context 10
} > "$out"

commits=$(jj log -r "${base}..${head}" --no-graph -T 'commit_id ++ "\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
