#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE snapshot keeps multi-revision
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# Default OUTFILE: <workspace-root>/.tmp/rocketclaw/sdd/<plan-basename>/review-<base7>..<tip7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base=$(jj log --no-graph -r "exactly(commit_id($base), 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "bad BASE commit ID: $base" >&2; exit 2; }
tip=$(jj log --no-graph -r "exactly(commit_id($tip), 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "bad TIP commit ID: $tip" >&2; exit 2; }
revset="commit_id($base)..commit_id($tip)"

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base:0:7}..${tip:0:7}.diff"
fi

{
  echo "# Review package: ${base}..${tip}"
  echo
  echo "## Revisions"
  jj log --no-graph -r "$revset" \
    -T 'commit_id.short(12) ++ " " ++ change_id.short(12) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj diff --stat --from "commit_id($base)" --to "commit_id($tip)"
  echo
  echo "## Diff"
  jj diff --git --context 10 --from "commit_id($base)" --to "commit_id($tip)"
} > "$out"

revisions=$(jj log --count -r "$revset")
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
