#!/usr/bin/env bash
# Generate a review package: revision list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not @-) keeps multi-revision
# tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# Default OUTFILE: <workspace-root>/.tmp/sdd/<plan-basename>/review-<base7>..<tip7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

case "$base" in
  ''|*[!0-9a-f]*) echo "bad BASE commit ID: $base" >&2; exit 2 ;;
esac
case "$tip" in
  ''|*[!0-9a-f]*) echo "bad TIP commit ID: $tip" >&2; exit 2 ;;
esac

base_commit=$(jj --ignore-working-copy log --no-graph -r "exactly(commit_id($base), 1)" -T 'commit_id') || {
  echo "bad BASE: $base" >&2
  exit 2
}
tip_commit=$(jj --ignore-working-copy log --no-graph -r "exactly(commit_id($tip), 1)" -T 'commit_id') || {
  echo "bad TIP: $tip" >&2
  exit 2
}
base_short=${base_commit:0:7}
tip_short=${tip_commit:0:7}

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base_short}..${tip_short}.diff"
fi

{
  echo "# Review package: ${base}..${tip}"
  echo
  echo "## Revisions"
  jj --ignore-working-copy log --no-graph -r "${base_commit}..${tip_commit}" \
    -T 'change_id.short(12) ++ " " ++ commit_id.short(12) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --from "$base_commit" --to "$tip_commit" --stat
  echo
  echo "## Diff"
  jj --ignore-working-copy diff --from "$base_commit" --to "$tip_commit" --git --context 10
} > "$out"

revisions=$(jj --ignore-working-copy log -r "${base_commit}..${tip_commit}" --count)
echo "wrote ${out}: ${revisions} revision(s), $(wc -c < "$out" | tr -d ' ') bytes"
