#!/usr/bin/env bash
# Generate a review package: change list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Full commit IDs preserve the exact endpoint even when Jujutsu rewrites
# a change. Using the recorded per-task BASE keeps multi-change tasks intact.
#
# Usage: review-package PLAN_FILE BASE TIP [OUTFILE]
# Default OUTFILE: <workspace-root>/.tmp/rocketclaw/sdd/<plan-basename>/review-<base12>..<tip12>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package PLAN_FILE BASE TIP [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
tip=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

base_id=$(jj --ignore-working-copy log --no-graph -r "exactly($base, 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "BASE must resolve to one Jujutsu revision: $base" >&2; exit 2; }
tip_id=$(jj --ignore-working-copy log --no-graph -r "exactly($tip, 1)" -T 'commit_id ++ "\n"' 2>/dev/null) \
  || { echo "TIP must resolve to one Jujutsu revision: $tip" >&2; exit 2; }
[ -n "$base_id" ] || { echo "BASE resolved to no commit: $base" >&2; exit 2; }
[ -n "$tip_id" ] || { echo "TIP resolved to no commit: $tip" >&2; exit 2; }
range="commit_id($base_id)..commit_id($tip_id)"

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/review-${base_id:0:12}..${tip_id:0:12}.diff"
fi

{
  echo "# Review package: ${base_id}..${tip_id}"
  echo
  echo "## Changes"
  jj --ignore-working-copy log --no-graph -r "$range" \
    -T 'change_id.short(12) ++ " " ++ description.first_line() ++ "\n"'
  echo
  echo "## Files changed"
  jj --ignore-working-copy diff --stat \
    --from "commit_id($base_id)" --to "commit_id($tip_id)"
  echo
  echo "## Diff"
  jj --ignore-working-copy --color=never diff --context 10 \
    --from "commit_id($base_id)" --to "commit_id($tip_id)"
} > "$out"

changes=$(jj --ignore-working-copy log --no-graph -r "$range" -T '"x\n"' | wc -l | tr -d ' ')
echo "wrote ${out}: ${changes} change(s), $(wc -c < "$out" | tr -d ' ') bytes"
